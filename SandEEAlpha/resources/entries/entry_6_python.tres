script = ExtResource("1_t72nc")
entry_name = "Strings"
description = "In Python we call words, sentences, phrases as strings. to store strings in python we need to declare a variable to hold them first and then we will call that variable to print the text inside it.

for example:

first_name = \"Kairo\"
fav_food = \"Jollibee chicken\"
print(first_name)
print(fav_food)

output:
Kairo
Jollibee Chicken

"
keyword = "string"
language = "python"
category = "Easy"
metadata/_custom_type_script = "uid://c8mblthys4abt"

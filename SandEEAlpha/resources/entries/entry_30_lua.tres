[resource]
script = ExtResource("1_script")
entry_name = "Lua Loops"
description = "Lua provides three loop types: for, while, and repeat.

Numeric for loop:

for i = 1, 5 do
    print(i)
end

While loop (checks condition before each iteration):

local i = 1
while i <= 5 do
    print(i)
    i = i + 1
end

Repeat loop (runs at least once, checks condition at the end):

local i = 1
repeat
    print(i)
    i = i + 1
until i > 5

All loops are ended with the keyword end, except repeat which uses until."
keyword = "for"
language = "lua"
category = "Easy"

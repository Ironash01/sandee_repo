[ext_resource type="Script" uid="uid://c8mblthys4abt" path="res://resources/entries/entry_data.gd" id="1_script"]

[resource]
script = ExtResource("1_script")
entry_name = "Lua Station Crafting"
description = "Automatica can operate a nearby Crafting Station through the same API documented in the Programming Encyclopedia.

Choose a recipe by its output name:

set_recipe(\"Planks\")

Load the station input from the robot's build palette or the player inventory:

put_input(\"Wood\", 2)

Craft the selected amount, then collect the result:

craft(2)
take_output()

Every call goes through the station's real validation. If the ingredients are missing, the station prints a short reason instead of creating items. Use list_items() when you need exact item names. The helper functions exist in the Automatica environment, so print(type(set_recipe)) displays function."
keyword = "set_recipe"
language = "lua"
category = "Medium"

script = ExtResource("1_jlo57")
entry_name = "Arithmetic Expressions"
description = "In python we have what we call the arithmetic expressions where it is the basic math that we learned in school. This operators are (+, -, /, *, %)

Addition: Using the (+) operator
We will declare a variable first where we store the sum of 2 or more numbers. for example:

sum = 1 + 1
print(sum)

output: 2

Subtraction: Using the (-) operator
We will declare a variable first where we store the difference of 2 or more numbers. for example:

diff = 1 - 1
print(diff)

output: 0

Multiplication: : Using the (*) operator
We will declare a variable first where we store the product of 2 or more numbers. for example:

prod = 1 * 1
print(prod)

output: 1

Division:
We will declare a variable first where we store the quotient of 2 or more numbers. for example:

quo = 1 / 1
print(quo)

output: 1

Modulo: Using the (%) operator
We will declare a variable first where we store the remainder of 2 or more numbers. for example:

prod = 12 % 7
print(prod)

output: 5 ---> this is the answer because when we divide 12 by 7 the remainder wil be 5.
"
keyword = "Arithmetic Expressions"
language = "python"
category = "Easy"
metadata/_custom_type_script = "uid://c8mblthys4abt"

[resource]
script = ExtResource("1_script")
entry_name = "Lua Strings"
description = "In Lua, strings are sequences of characters enclosed in double or single quotes. You concatenate strings with the .. operator.

To concatenate two strings:

print(\"Hello\" .. \" \" .. \"World\")  -- Hello World

To get the length of a string, use string.len():

local s = \"Lua\"
print(string.len(s))  -- 3

You can also use the # operator:

print(#s)  -- 3

Strings in Lua are immutable. Concatenating creates a new string."
keyword = ".."
language = "lua"
category = "Easy"

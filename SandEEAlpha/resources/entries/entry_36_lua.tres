[resource]
script = ExtResource("1_script")
entry_name = "Lua Coroutines"
description = "Coroutines in Lua provide cooperative multitasking. They can be paused and resumed.

Creating a coroutine:

local co = coroutine.create(function()
    coroutine.yield(1)
    coroutine.yield(2)
    return 3
end)

Resuming:

print(coroutine.resume(co))  -- true  1
print(coroutine.resume(co))  -- true  2
print(coroutine.resume(co))  -- true  3

coroutine.yield pauses execution and returns a value. coroutine.resume continues it. The first return value of resume is a success boolean."
keyword = "coroutine"
language = "lua"
category = "Medium"

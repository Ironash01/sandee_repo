[resource]
script = ExtResource("1_p1gly")
entry_name = "Numbers and Strings"
description = "Numbers and Strings are common data types. Numbers are already obvious, while Strings use quotation marks. Using quotation marks on a number however turns it into string.
age = 20 -- number
name = \"Davis\" - string
"
keyword = "Number, String"
category = "Basics"

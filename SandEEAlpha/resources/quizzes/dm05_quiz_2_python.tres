[resource]
script = ExtResource("1_houyf")
question_name = "Let's Add"
question = "In this exercise you shall identify and code what are the numbers that are needed to be added based on the statement below. You will declare a variable called sum that holds all the vales. NOTE: The answer in this question is not the total sum of the added numbers.

I have 56 hotwheels cars, 10 tomica cars, and 15 majorette cars. I wonder how many cars i have?

How are we going to code this using the addition operation?"
answer_long = "sum = 56 + 10 + 15"

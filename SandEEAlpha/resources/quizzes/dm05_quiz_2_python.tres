[resource]
script = ExtResource("1_houyf")
question_name = "Let's Add"
question = "In this exercise you shall code the numbers that are needed to be added based on the given  below. You will declare a variable called sum that holds all the values. NOTE: The answer in this question is not the total sum of the added numbers.

Clue: Start num1, end num3.

num1 = 10
num2 = 4
num3 = 14

How are we going to code this using the addition operation?"
answer_long = "sum = num1 + num2 + num3"
metadata/_custom_type_script = "uid://d1g3k0mq7l5wj"

[sub_resource type="Resource" id="DungeonQuestion_1"]
script = ExtResource("2_question")
type = 1
question = "Write a Lua program that uses string.match to find the first number in the string \"abc123def\" and prints it."
language = "lua"
starter_code = "print(string.match(\"abc123def\", \"%d+\"))"
answer_output = "123"

[sub_resource type="Resource" id="DungeonQuestion_2"]
script = ExtResource("2_question")
type = 0
question = "What pattern character matches any digit in Lua?"
answer_a = "%d"
answer_b = "%s"
answer_c = "%w"
answer_d = "%n"
correct_index = 0

[sub_resource type="Resource" id="DungeonQuestion_3"]
script = ExtResource("2_question")
type = 1
question = "Write a Lua program that uses string.match with the pattern \"%a+\" to extract the first word from \"Hello World\" and print it."
language = "lua"
starter_code = "print(string.match(\"Hello World\", \"%a+\"))"
answer_output = "Hello"

[resource]
script = ExtResource("1_script")
mission_name = "Lua Pattern Matching"
mission_description = "Learn how to use string.match with Lua patterns to search and extract text."
entry_resource_file = "entry_34_lua.tres"
questions = Array[ExtResource("2_question")]([SubResource("DungeonQuestion_1"), SubResource("DungeonQuestion_2"), SubResource("DungeonQuestion_3")])

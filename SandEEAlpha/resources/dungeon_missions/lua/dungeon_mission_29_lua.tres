[sub_resource type="Resource" id="DungeonQuestion_1"]
script = ExtResource("2_question")
type = 0
question = "Which keywords form an if-else block in Lua?"
answer_a = "if/then/else/end"
answer_b = "if/then/else/endif"
answer_c = "if/do/else/end"
answer_d = "if/then/else/done"
correct_index = 0

[sub_resource type="Resource" id="DungeonQuestion_2"]
script = ExtResource("2_question")
type = 1
question = "Write a Lua program that checks if a variable x equals 5 and prints \"five\" if true, \"not five\" otherwise."
language = "lua"
starter_code = ""
answer_output = "five"

[sub_resource type="Resource" id="DungeonQuestion_3"]
script = ExtResource("2_question")
type = 1
question = "Write a Lua program that uses elseif to print \"positive\" if x is greater than 0, \"zero\" if x is 0, and \"negative\" otherwise. Set x to -3."
language = "lua"
starter_code = ""
answer_output = "negative"


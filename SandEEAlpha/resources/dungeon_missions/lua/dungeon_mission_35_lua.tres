[sub_resource type="Resource" id="DungeonQuestion_1"]
script = ExtResource("2_question")
type = 0
question = "What is used to set up inheritance and operator overloading in Lua OOP?"
answer_a = "classes"
answer_b = "prototypes"
answer_c = "metatables"
answer_d = "interfaces"
correct_index = 2

[sub_resource type="Resource" id="DungeonQuestion_2"]
script = ExtResource("2_question")
type = 1
question = "Write a Lua program that creates a table Dog with a bark method using a metatable, creates a Dog instance, and calls bark()."
language = "lua"
starter_code = "Dog = {}\nDog.__index = Dog\nfunction Dog:new(name)\n    local obj = setmetatable({}, Dog)\n    obj.name = name\n    return obj\nend\nfunction Dog:bark()\n    print(self.name .. \" says woof\")\nend\nlocal d = Dog:new(\"Rex\")\nd:bark()"
answer_output = "Rex says woof"

[sub_resource type="Resource" id="DungeonQuestion_3"]
script = ExtResource("2_question")
type = 0
question = "What does the 'self' keyword refer to in a Lua method?"
answer_a = "The class itself"
answer_b = "The current instance"
answer_c = "The parent class"
answer_d = "The global table"
correct_index = 1


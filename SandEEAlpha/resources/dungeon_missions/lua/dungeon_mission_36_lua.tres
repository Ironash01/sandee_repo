[sub_resource type="Resource" id="DungeonQuestion_1"]
script = ExtResource("2_question")
type = 0
question = "Which function creates a new coroutine in Lua?"
answer_a = "coroutine.new"
answer_b = "coroutine.create"
answer_c = "coroutine.spawn"
answer_d = "coroutine.init"
correct_index = 1

[sub_resource type="Resource" id="DungeonQuestion_2"]
script = ExtResource("2_question")
type = 1
question = "Write a Lua program that creates a coroutine that yields the values 1, 2, 3 one at a time, and resumes it three times printing each result."
language = "lua"
starter_code = "local co = coroutine.create(function()\n    coroutine.yield(1)\n    coroutine.yield(2)\n    coroutine.yield(3)\nend)\nprint(coroutine.resume(co))\nprint(coroutine.resume(co))\nprint(coroutine.resume(co))"
answer_output = "true\t1\ntrue\t2\ntrue\t3"

[sub_resource type="Resource" id="DungeonQuestion_3"]
script = ExtResource("2_question")
type = 0
question = "What does coroutine.yield do?"
answer_a = "Destroys the coroutine"
answer_b = "Pauses execution and returns a value"
answer_c = "Starts the coroutine"
answer_d = "Resumes the coroutine"
correct_index = 1

[resource]
script = ExtResource("1_script")
mission_name = "Lua Coroutines"
mission_description = "Learn how to use coroutines in Lua for cooperative multitasking with coroutine.create and coroutine.yield."
entry_resource_file = "entry_36_lua.tres"
questions = Array[ExtResource("2_question")]([SubResource("DungeonQuestion_1"), SubResource("DungeonQuestion_2"), SubResource("DungeonQuestion_3")])

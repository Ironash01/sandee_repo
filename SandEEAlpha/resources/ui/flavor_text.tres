script = ExtResource("1_flavor")
lines = PackedStringArray("Also try mining!", "Now with 100% more sand!", "Beware the desert worm.", "LUAs never sleep.", "Built by BSCS701.", "Smelt it or eat it raw.", "Water is not a floor.", "Punching trees is encouraged.", "The quiz room is not safe.", "Doors keep the wind out.", "Wolves hate the ocean.", "Place a bonfire, save a life.", "Diamonds are deep down.", "Craft first, explore later.", "Every block was placed by someone.", "Fishing takes patience.", "Beware the hitman's aim.", "Sand gets everywhere.", "Your LUA is watching.", "Alpha means 'we are still fixing it'.")

[configuration]
entry_symbol = "gdext_rust_init"
compatibility_minimum = 4.6
reloadable = true

[libraries]
linux.debug.x86_64 =     "res://ext_bin/release/libinterpreter.so"
linux.release.x86_64 =   "res://ext_bin/release/libinterpreter.so"
windows.debug.x86_64 = "res://ext_bin/release/interpreter.dll"
windows.release.x86_64 = "res://ext_bin/release/interpreter.dll"

[dependencies]
windows.debug = {
"res://ext_bin/release/libstdc++-6.dll": "",
"res://ext_bin/release/libgcc_s_seh-1.dll": "",
"res://ext_bin/release/libwinpthread-1.dll": ""
}
windows.release = {
"res://ext_bin/release/libstdc++-6.dll": "",
"res://ext_bin/release/libgcc_s_seh-1.dll": "",
"res://ext_bin/release/libwinpthread-1.dll": ""
}

[icons]
LuaState = "res://extension/lua.svg"
PythonTranspiler = "res://extension/python-config.svg"

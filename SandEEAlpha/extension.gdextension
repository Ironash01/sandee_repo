[configuration]
entry_symbol = "gdext_rust_init"
compatibility_minimum = 4.5
reloadable = true

[libraries]
linux.debug.x86_64 =     "res://extension/target/debug/libinterpreter.so"
linux.release.x86_64 =   "res://extension/target/release/libinterpreter.so"
windows.debug.x86_64 =   "res://extension/target/debug/interpreter.dll"
windows.release.x86_64 = "res://extension/target/release/interpreter.dll"
